{
  "openapi": "3.1.0",
  "info": {
    "title": "bmo-discord",
    "version": "0.1.0-rev.1",
    "description": "The Discord chat provider's own API: the loopback seam between its two processes, grouped by the resource each route acts on. The provider routes another unit calls are bmo-chat's, stated in its `docs/protocol.md` and `docs/openapi/provider.json`; this document states only what this repository adds. Every body that is a chat piece is a reference to bmo-chat's OpenAPI documents rather than a copy, so bmo-chat's document is canonical where the two disagree. Bodies are JSON with camelCase keys, times are integers of epoch milliseconds, and every non-2xx answer is the error shape with `code` and `error`."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3230",
      "description": "the service"
    },
    {
      "url": "http://127.0.0.1:3231",
      "description": "the gateway"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "x-layer": "downstream",
  "x-stage": 8,
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The bearer every route takes, read from BMO_DISCORD_ROUTE_TOKEN (docs/boundary-api.md, 「Configuration」)."
      }
    },
    "schemas": {
      "Heard": {
        "type": "object",
        "description": "Whether the bot account's socket hears one thing now, and where it does not, why.",
        "properties": {
          "heard": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "heard",
          "reason"
        ]
      },
      "Hearing": {
        "type": "object",
        "description": "What the bot account's socket hears beside messages (docs/discord.md, 「Typing and presence」).",
        "properties": {
          "peopleTyping": {
            "$ref": "#/components/schemas/Heard"
          },
          "presence": {
            "$ref": "#/components/schemas/Heard"
          }
        },
        "required": [
          "peopleTyping",
          "presence"
        ]
      },
      "PersonInRooms": {
        "description": "One person's presence beside the rooms they stand in.",
        "allOf": [
          {
            "$ref": "../../../base/chat/docs/openapi/receiver.json#/components/schemas/PersonPresence"
          },
          {
            "type": "object",
            "properties": {
              "roomIds": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "required": [
              "roomIds"
            ]
          }
        ]
      },
      "PresenceInRooms": {
        "type": "object",
        "description": "Whether people are reachable now, each beside the rooms they stand in; the service tells the people who stand in a room the receiving side listens to.",
        "properties": {
          "via": {
            "type": "string"
          },
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonInRooms"
            }
          },
          "whole": {
            "type": "boolean",
            "description": "Whether the list is every person the provider tells presence of."
          }
        },
        "required": [
          "via",
          "people",
          "whole"
        ]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Whether the gateway is ready",
        "x-call": {
          "language": "rust",
          "name": "health",
          "answer": "ChatHealth"
        },
        "responses": {
          "200": {
            "description": "Whether the gateway is ready, why not where it is not, the bot token unset where it is ready without one (docs/discord.md, The bot token), and its version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/ChatHealth"
                }
              }
            }
          },
          "default": {
            "description": "The error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/WireError"
                }
              }
            }
          }
        }
      }
    },
    "/sends": {
      "post": {
        "operationId": "send",
        "summary": "One send into a room",
        "x-call": {
          "language": "rust",
          "name": "send",
          "request": "ChatSendRequest",
          "answer": "ChatSent",
          "refusal": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/ChatSendRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The send the gateway performed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/ChatSent"
                }
              }
            }
          },
          "default": {
            "description": "A refusal or a failure, in the error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/WireError"
                }
              }
            }
          }
        }
      }
    },
    "/rooms/{roomId}": {
      "get": {
        "operationId": "room",
        "summary": "One room as the gateway knows it",
        "x-call": {
          "language": "rust",
          "name": "room",
          "answer": "ProviderRoom",
          "key": "roomId",
          "optional": true
        },
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The room.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/ProviderRoom"
                }
              }
            }
          },
          "404": {
            "description": "The number is not one of this provider's rooms.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/WireError"
                }
              }
            }
          },
          "default": {
            "description": "The error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/WireError"
                }
              }
            }
          }
        }
      }
    },
    "/rooms/{roomId}/members": {
      "get": {
        "operationId": "members",
        "summary": "A room's members as the gateway lists them",
        "x-call": {
          "language": "rust",
          "name": "members",
          "answer": "ChatMembers",
          "key": "roomId"
        },
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The room's members, whole: a DM's recipient and the bot account, or a guild channel's bot account and every person heard writing in it whom Discord confirms is still in the guild.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/ChatMembers"
                }
              }
            }
          },
          "404": {
            "description": "The gateway holds no members of the room, with the reason.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/WireError"
                }
              }
            }
          },
          "default": {
            "description": "The error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/WireError"
                }
              }
            }
          }
        }
      }
    },
    "/owner": {
      "get": {
        "operationId": "owner",
        "summary": "The room to reach the owner in",
        "x-call": {
          "language": "rust",
          "name": "owner",
          "answer": "ProviderOwner"
        },
        "responses": {
          "200": {
            "description": "The room to speak into to reach the owner unprompted, or null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/ProviderOwner"
                }
              }
            }
          },
          "default": {
            "description": "The error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/WireError"
                }
              }
            }
          }
        }
      }
    },
    "/owner-account": {
      "get": {
        "operationId": "ownerAccount",
        "summary": "Whether the gateway has confirmed the owner's account",
        "x-call": {
          "language": "rust",
          "name": "ownerAccount",
          "answer": "ChatHealth"
        },
        "responses": {
          "200": {
            "description": "Whether the owner's account is confirmed (`ready`), why not where it is not, and the gateway's version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/ChatHealth"
                }
              }
            }
          },
          "default": {
            "description": "The error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/WireError"
                }
              }
            }
          }
        },
        "description": "Answered from the gateway's last confirmation of the owner's account with Discord (docs/discord.md, 「The owner's account」); answering it makes no call on Discord."
      }
    },
    "/hearing": {
      "get": {
        "operationId": "hearing",
        "summary": "What the bot account's socket hears beside messages",
        "x-call": {
          "language": "rust",
          "name": "hearing",
          "answer": "Hearing"
        },
        "description": "Answered from what the gateway holds; answering it makes no call on Discord.",
        "responses": {
          "200": {
            "description": "Whether typing and presence are heard, and where not, why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hearing"
                }
              }
            }
          },
          "default": {
            "description": "The error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/provider.json#/components/schemas/WireError"
                }
              }
            }
          }
        }
      }
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "put": {
        "operationId": "handOver",
        "summary": "One message handed over to the receiving side",
        "x-call": {
          "language": "typescript",
          "name": "handOver",
          "request": "HandedMessage",
          "answer": "HandedMessage"
        },
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../base/chat/docs/openapi/receiver.json#/components/schemas/HandedMessage"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The receiving side did not hold the message before.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/receiver.json#/components/schemas/HandedMessage"
                }
              }
            }
          },
          "200": {
            "description": "The receiving side held the message before.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/receiver.json#/components/schemas/HandedMessage"
                }
              }
            }
          },
          "default": {
            "description": "The receiving side's answer, passed on in the error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/receiver.json#/components/schemas/WireError"
                }
              }
            }
          }
        }
      }
    },
    "/typing-marks": {
      "post": {
        "operationId": "typingMarked",
        "summary": "One typing mark told to the receiving side",
        "x-call": {
          "language": "typescript",
          "name": "typingMarked",
          "request": "TypingMark"
        },
        "description": "Told where the receiving side listens to the room, and passed over where it does not. The gateway offers a mark once.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../base/chat/docs/openapi/receiver.json#/components/schemas/TypingMark"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Told, or passed over for a room the receiving side does not listen to."
          },
          "default": {
            "description": "The receiving side's answer, passed on in the error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/receiver.json#/components/schemas/WireError"
                }
              }
            }
          }
        }
      }
    },
    "/presence-changes": {
      "post": {
        "operationId": "presenceChanged",
        "summary": "People's presence told to the receiving side",
        "x-call": {
          "language": "typescript",
          "name": "presenceChanged",
          "request": "PresenceInRooms"
        },
        "description": "The people who stand in a room the receiving side listens to are told as a presence change; a whole change is told whole. The gateway offers it again while the service refuses the connection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresenceInRooms"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Told."
          },
          "default": {
            "description": "The receiving side's answer, passed on in the error shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../base/chat/docs/openapi/receiver.json#/components/schemas/WireError"
                }
              }
            }
          }
        }
      }
    }
  }
}
