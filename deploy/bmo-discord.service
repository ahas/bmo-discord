# The service's user unit (docs/boundary-api.md): the Rust provider, running the release binary as
# `bmo-discord serve` in the release, with the environment the release's discord.env links from the data root's
# env file. Marked bot: the one service a deployment waits on for its health.
[Unit]
Description=bmo-discord: the Discord chat provider
After=network-online.target
# The provider does not stand where the deployment's env file is missing.
ConditionPathExists=%h/.local/share/bmo/data/env/discord.env

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bmo-discord/deploy
EnvironmentFile=-%h/.local/share/bmo-discord/deploy/discord.env
ExecStart=%h/.local/share/bmo-discord/deploy/bin/bmo-discord serve
Restart=always
RestartSec=2
# A stop signals the service, which stops watching the gateway and ends; the wait bounds it.
TimeoutStopSec=30

[Install]
WantedBy=default.target
# Linked, enabled, stopped, restarted and watched by every deployment.
X-BMO-Deploy=bot
