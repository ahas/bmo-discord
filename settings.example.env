# The environment both processes read (docs/boundary-api.md, 「Configuration」), with neutral example values.
# A deployment writes its own as env/discord.env under the data root.

# The platform's credentials and the owner's account; each mode stands on its own token.
BMO_DISCORD_TOKEN=example-bot-token
BMO_DISCORD_SELF_TOKEN=example-agent-user-token
BMO_DISCORD_OWNER_ID=100000000000000001
BMO_DISCORD_OWNER_CHANNEL=100000000000000002
BMO_DISCORD_STICKERS=🙂:100000000000000003,😂:100000000000000004

# The provider's own.
BMO_DISCORD_PORT=3230
BMO_DISCORD_GATEWAY_PORT=3231
BMO_DISCORD_ROUTE_TOKEN=example-route-token
BMO_DISCORD_RECEIVER_URL=http://127.0.0.1:3200
BMO_DISCORD_RECEIVER_TOKEN=example-receiver-token
BMO_DISCORD_DATA=/var/lib/example/discord
BMO_DISCORD_SENDER_NAME=agent
BMO_DISCORD_CLIENT_NAME=agent
